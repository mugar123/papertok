node_modules
dist
.wrangler
/worker-configuration.d.ts
.vercel
.dev.vars*
.env
.env.local
.env.*
# `.env.*` above matches `.env.example` too, and that file is documentation, not
# a secret: it is the only record in the repo of the eleven VITE_* variables the
# build needs, since `.env.local` is ignored. It survived for a long time only
# because it was tracked before the `.env.*` rule existed — so once anything
# removes it from the index it becomes invisible to `git add -A` and silently
# stops being committed. This negation is what keeps it tracked.
!.env.example
.DS_Store
.claude/*
!.claude/settings.json
!.claude/agents/

# Firestore emulator artefacts (npm run test:rules)
firestore-debug.log
firebase-debug.log
# Accounts and documents saved by `npm run dev:emulators` between runs
/.firebase-emulators/

# Local scratch space for subagent work.
.superpowers/

# Local investigations, audits and task reports must not enter commits.
/.local/
/docs/AUDITORIA-*.md
/docs/VERIFICATION-*.md
/docs/LATENCIA-*.md
/docs/FUENTES-FEED-*.md
/docs/plan/
/docs/superpowers/
