{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"]
  },
  "include": [
    "tests/**/*.ts",
    "scripts/**/*.ts",
    "*.config.ts",
    "eslint-rules/**/*.ts",
    "src/types/**/*.d.ts"
  ],
  "exclude": [
    "scripts/diagnostics"
  ]
}
