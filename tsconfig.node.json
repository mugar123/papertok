{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"]
  },
  "include": [
    "src/**/*.test.js",
    "src/**/*.test.ts",
    "proxy/**/*.test.js",
    "proxy/**/*.test.ts",
    "tests/**/*.js",
    "tests/**/*.ts",
    "scripts/**/*.js",
    "scripts/**/*.mjs",
    "scripts/**/*.ts",
    "*.config.js",
    "*.config.ts"
  ],
  "exclude": [
    "scripts/diagnostics",
    "src/services/paperFigureService.test.js",
    "src/components/Institution/publisherLogos.test.js",
    "src/utils/aiExplanation.test.js"
  ]
}
