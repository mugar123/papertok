rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function ownsUserTree(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function validString(value, maximum) {
      return value is string && value.size() <= maximum;
    }

    // `validString` accepts the empty string, which is right for an optional
    // label and wrong for a field that identifies something: '' passes `is
    // string && size() <= max` and lands as a document nothing can resolve.
    // Used where the client already refuses to write an empty value, so the
    // database refuses it too rather than trusting the client to keep doing it.
    function validNonEmptyString(value, maximum) {
      return value is string && value.size() > 0 && value.size() <= maximum;
    }

    // ---------------------------------------------------------------------
    // Public lists (F11). Server-written, and that is the whole design.
    //
    // These documents used to be validated here, per paper, from the client.
    // They cannot be: the rules engine stops at 1000 evaluated expressions per
    // request and ONE realistic paper already exceeded that budget, so
    // publishing was refused outright in production. Measured in
    // tests/p18-measure.test.js, with the ceiling for every trimmed variant —
    // no honest trim left the product cap above six papers.
    //
    // So the write moved to the Worker, which validates in real code with the
    // service identity (`worker/public-list-api.js`) and holds the single
    // definition of a valid public list in `src/services/publicListPayload.js`,
    // the same module the browser imports. Here, only two things remain true:
    // anyone may read a share link, and nobody may write one.
    //
    // `publicListOwners` stays unreadable and unwritable from the client. It is
    // still read by these rules themselves — `ownsPinnedShare` below — because a
    // rules-internal get() is not an `allow read`.
    function userProfileKeys() {
      return [
        'onboardingComplete',
        'preferences',
        'selectedCategories',
        'followedAuthors',
        'followingMigratedAt',
        'readingPreferences',
        'profilePhoto',
        // A guest's yes to the email digest, waiting for the first follow
        // (src/context/EmailNotificationsContext.jsx). A bool, then deleted.
        'emailDigestOptIn'
      ];
    }

    // Fields an early version of the app wrote into users/{uid} and nothing has
    // written since; every one of them is a copy of the Firebase Auth record,
    // which stays the source of truth. They are here because every write the
    // app makes to that document is a merge, so `request.resource.data` is the
    // whole merged document: an allowlist that does not name them denies every
    // write on an account of that vintage, which is what it did.
    //
    // Tolerated, not writable — see frozenUserFieldsUntouched().
    function legacyUserKeys() {
      return ['email', 'displayName', 'photoURL', 'createdAt'];
    }

    // Fields the Worker writes with the service identity after verifying a
    // proof the client cannot show these rules: `institution` is the
    // university a verified address resolved to (worker/institution-link.js).
    // Tolerated in a merge so the client's own writes keep working once the
    // field exists; never writable, or anyone could award themselves one.
    function serviceUserKeys() {
      return ['institution'];
    }

    function frozenUserKeys() {
      return legacyUserKeys().concat(serviceUserKeys());
    }

    // A write may carry the frozen fields along unchanged; it may not add, edit
    // or drop one. So an account that has them keeps exactly the values it has,
    // an account that does not can never acquire them, and tolerating the keys
    // above does not hand the account holder a writable `email` in a document
    // that reads like identity. Deleting a legacy field is the backfill's job,
    // and clearing `institution` is the Worker's; both run with a service
    // identity, past these rules.
    function frozenUserFieldsUntouched() {
      return resource == null
        ? !request.resource.data.keys().hasAny(frozenUserKeys())
        : !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(frozenUserKeys());
    }

    match /publicLists/{shareId} {
      // A share link is public, as it always was: one document, one read.
      allow get: if true;
      // Paging is not. `allow read` covered both, so anyone could have walked
      // the whole collection and harvested every list ever published — a
      // directory the product never offers. Nothing reads it that way: the page
      // fetches one share id, and profile pins render from the profile.
      allow list: if false;
      // Every write comes from the Worker, past these rules entirely.
      allow write: if false;
    }

    match /publicListOwners/{shareId} {
      allow read: if false;
      allow write: if false;
    }

    // ---------------------------------------------------------------------
    // Public user profiles (F1). Additive: nothing above this line changes.
    // ---------------------------------------------------------------------

    function isAdmin() {
      // The moderation queue landed with F3, so the placeholder gave way to
      // the real thing: @mugar's uid, resolved from handles/mugar. A uid is
      // not a secret. Changing admins is editing this line and deploying.
      return request.auth != null
        && request.auth.uid == 'SrqikE0wbtPOsTZMnvK4lcLVHhD3';
    }

    // Handles that would collide with an application route or let an account
    // pose as staff. Kept identical to RESERVED_HANDLES in
    // src/utils/userHandle.js; userHandle.test.js fails if the two drift.
    function reservedHandles() {
      return [
        'about', 'admin', 'administrator', 'api', 'assets', 'auth',
        'contact', 'docs', 'entity', 'explorer', 'feed', 'following', 'help',
        'legal', 'list', 'lists', 'login', 'logout', 'me', 'moderator',
        'onboarding', 'paper', 'papers', 'papertok', 'privacy', 'profile',
        'public', 'register', 'report', 'research', 'root', 'search',
        'security', 'settings', 'signin', 'signup', 'staff', 'support',
        'system', 'team', 'terms', 'user', 'users', 'www'
      ];
    }

    function validHandleSegment(handle) {
      return handle.matches('^[a-z0-9_]{3,40}$')
        && handle.matches('^[a-z0-9_]*[a-z][a-z0-9_]*$')
        && !(handle in reservedHandles());
    }

    // Ownership of a pinned share, in ONE document access.
    //
    // The obvious form spends two (exists + get); at eight pinned lists that
    // would be sixteen and blow the ten-call ceiling for a single-document
    // request. A missing owner document makes `get()` return null, and reading
    // `.data` off null denies the write — which is the outcome we want for a
    // share id that does not exist.
    function ownsPinnedShare(shareId) {
      return get(/databases/$(database)/documents/publicListOwners/$(shareId))
        .data.ownerId == request.auth.uid;
    }

    // A pinned list is a denormalized card: enough to render the profile
    // without reading publicLists, and nothing else. The public list document
    // itself is never touched by pinning — but the pin must be the owner's own
    // list, or attribution would be forgeable by anyone who knows a share id.
    function validPinnedList(entry) {
      return entry.keys().hasOnly(['shareId', 'title', 'emoji', 'paperCount'])
        && entry.shareId is string
        && entry.shareId.matches('^[a-f0-9]{32}$')
        && entry.title is string
        && entry.title.size() > 0
        && entry.title.size() <= 120
        && (!('emoji' in entry)
          || entry.emoji is string && entry.emoji.size() <= 40)
        && entry.paperCount is int
        && entry.paperCount >= 0
        // Mirrors PUBLIC_LIST_LIMITS.papers, the cap on the public list the
        // card denormalizes. F11 raised that cap from 12 to 50 and this
        // literal was left behind, so every card sat capped at "12 papers".
        // A test in userProfileService.test.js holds the two numbers together.
        && entry.paperCount <= 50
        && ownsPinnedShare(entry.shareId);
    }

    // Six, and the ceiling is measured, not chosen.
    //
    // Every entry costs one get() for its ownership check, but the binding
    // limit turned out to be the 1000-expression budget per rule evaluation,
    // not the 10-document-access one: against the emulator, seven pins pass and
    // eight fail outright with an expression-limit error. Six leaves one entry
    // of slack so that the next clause added to this file — F2 follows, F6
    // orcid — does not silently start rejecting saves for anyone sitting at the
    // cap. `tests/firestore.rules.test.js` pins both the cap and the headroom.
    function validPinnedLists(entries) {
      return entries is list
        && entries.size() <= 6
        && (entries.size() < 1 || validPinnedList(entries[0]))
        && (entries.size() < 2 || validPinnedList(entries[1]))
        && (entries.size() < 3 || validPinnedList(entries[2]))
        && (entries.size() < 4 || validPinnedList(entries[3]))
        && (entries.size() < 5 || validPinnedList(entries[4]))
        && (entries.size() < 6 || validPinnedList(entries[5]));
    }

    // F12: the pin is an ORDER, not a card. At most three share ids; the
    // cards they point at live in profileLists/{uid}, which only the Worker
    // writes, and the profile renders the intersection of the two. That is
    // why there is no ownership get() here: a forged or stale id points at
    // nothing in the caller's own showcase, so it pins nothing — the forgery
    // loses its prize instead of costing an ownership check per entry. This
    // is what retires the expression-budget spiral of validPinnedLists.
    //
    // `is string` survives mutation: without it, .matches() on a non-string
    // blows the evaluation and denies anyway. Kept as house style.
    function validPinnedShareIds(entries) {
      return entries is list
        && entries.size() <= 3
        && (entries.size() < 1
          || entries[0] is string && entries[0].matches('^[a-f0-9]{32}$'))
        && (entries.size() < 2
          || entries[1] is string && entries[1].matches('^[a-f0-9]{32}$'))
        && (entries.size() < 3
          || entries[2] is string && entries[2].matches('^[a-f0-9]{32}$'));
    }

    // orcid, verified and followerCount are written only by the service
    // identity (F6/F2), which bypasses rules. Declaring them untouchable for
    // clients here is the guarantee that a user cannot mark themselves verified
    // or award themselves followers. They stay in the hasOnly allowlist so that
    // a client update carrying the merged document is not rejected outright.
    function publicProfileServiceFieldsAbsent() {
      return !('orcid' in request.resource.data)
        && !('followerCount' in request.resource.data)
        && (!('verified' in request.resource.data)
          || request.resource.data.verified == false);
    }

    function publicProfileServiceFieldsUnchanged() {
      return ('orcid' in request.resource.data) == ('orcid' in resource.data)
        && (!('orcid' in resource.data)
          || request.resource.data.orcid == resource.data.orcid)
        && ('verified' in request.resource.data) == ('verified' in resource.data)
        && (!('verified' in resource.data)
          || request.resource.data.verified == resource.data.verified)
        && ('followerCount' in request.resource.data)
          == ('followerCount' in resource.data)
        && (!('followerCount' in resource.data)
          || request.resource.data.followerCount == resource.data.followerCount);
    }

    // Profile visibility (F8). A string rather than a boolean, and absence is
    // load-bearing: a document written before this phase has no `visibility`
    // and MUST keep reading as public. An absent boolean would coerce to false
    // and silently take every existing profile private, which is the one
    // outcome this design refuses.
    function profileIsPublic(data) {
      return !('visibility' in data) || data.visibility == 'public';
    }

    function validPublicProfile() {
      return request.resource.data.keys().hasOnly([
          'handle', 'displayName', 'bio', 'photo', 'orcid', 'verified',
          'allowContact', 'visibility', 'showPinnedLists', 'pinnedLists',
          'pinnedShareIds', 'showPhoto',
          'followerCount',
          'institution',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'handle', 'displayName', 'pinnedLists', 'createdAt', 'updatedAt'
        ])
        // The institution shown on the page is a copy of the one the Worker
        // verified on users/{uid} (worker/institution-link.js), and may only
        // ever equal it: the client copies it when the profile is created,
        // the Worker rewrites or clears both on link and unlink. One read,
        // only on a write that carries the field; a missing users document
        // makes the get() fail, which is a refusal, as it should be.
        && (!('institution' in request.resource.data)
          || request.resource.data.institution
            == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.institution)
        && validString(request.resource.data.handle, 40)
        // Grammar only. The reserved-name check lives on handles/{handle},
        // which every handle here must be backed by; repeating its 44-item
        // list on each profile write costs expression budget for nothing.
        && request.resource.data.handle.matches('^[a-z0-9_]{3,40}$')
        && validString(request.resource.data.displayName, 80)
        && request.resource.data.displayName.size() > 0
        && (!('bio' in request.resource.data)
          || validString(request.resource.data.bio, 500))
        // The recompressed public photo, not the 280 KB private one.
        && (!('photo' in request.resource.data)
          || validString(request.resource.data.photo, 60000))
        && (!('allowContact' in request.resource.data)
          || request.resource.data.allowContact is bool)
        // The owner's photo choice: with no photo on the page, "hidden" and
        // "none to show" are otherwise the same document.
        && (!('showPhoto' in request.resource.data)
          || request.resource.data.showPhoto is bool)
        && (!('visibility' in request.resource.data)
          || request.resource.data.visibility in ['public', 'private'])
        // Presentation state, not a disclosure boundary: hiding the pins means
        // `pinnedLists` is empty here and the entries are parked in the
        // owner-only document (Firestore has no field-level security, so the
        // array itself has to leave). This flag exists so that "no pins" and
        // "pins hidden" survive a reload as different states.
        && (!('showPinnedLists' in request.resource.data)
          || request.resource.data.showPinnedLists is bool)
        && validPinnedLists(request.resource.data.pinnedLists)
        // F12 transition: legacy card pins above, the new order-only pins
        // here. Both are accepted until every profile has migrated; rules v2
        // then retires validPinnedLists and the pinnedLists key. Absent on
        // every pre-F12 write, so this costs those writes two expressions.
        && (!('pinnedShareIds' in request.resource.data)
          || validPinnedShareIds(request.resource.data.pinnedShareIds))
        && (!('followerCount' in request.resource.data)
          || request.resource.data.followerCount is int
            && request.resource.data.followerCount >= 0)
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    match /userProfiles/{profileUid} {
      // A public profile page has to render for a signed-out reader, and
      // resolving a handle must not require a session. A private one is
      // readable by its owner and by nobody else — enforced here, at the data
      // layer, so "private" survives a caller that ignores the UI entirely.
      //
      // `get` only. `read` would also grant `list`, which lets anyone page
      // through the whole collection and walk off with the user directory,
      // photos included, billed to this project. Every read path in the app
      // addresses a profile by uid or resolves one through handles/.
      //
      // Not covered by going private, deliberately and stated in the UI: the
      // handle reservation stays readable (uniqueness has to be answerable, and
      // freeing the handle would make the switch one-way), and lists published
      // from Mis listas stay public (they are anonymous by design — going
      // private removes the attribution, not the list).
      allow get: if profileIsPublic(resource.data)
        || (request.auth != null && request.auth.uid == profileUid);
      allow list: if false;
      allow create: if request.auth != null
        && request.auth.uid == profileUid
        && validPublicProfile()
        && publicProfileServiceFieldsAbsent()
        // The choice is the feature, so a profile cannot come into existence
        // without it. Deployed only after every live client sends the field:
        // an older cached bundle creating a profile would otherwise be
        // refused. Updates stay exempt — legacy documents predate the field
        // and must keep being editable until their owner answers the prompt.
        && 'visibility' in request.resource.data
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        // The reservation has to land in the same batch AND be the caller's.
        // `existsAfter` alone was satisfied by somebody else's reservation,
        // so a profile could name a handle another account holds — and the
        // Worker, deleting that profile, freed the other account's handle
        // (audit 2026-09-10, finding 1). `getAfter` on a document that does
        // not exist after the batch is an evaluation error, which denies:
        // absence is still refused, exactly as before. Same read, one more
        // comparison; the pin cap measured six before and after (Task 2).
        && getAfter(
          /databases/$(database)/documents/handles/$(request.resource.data.handle)
        ).data.uid == request.auth.uid;
      allow update: if request.auth != null
        && request.auth.uid == profileUid
        && validPublicProfile()
        && publicProfileServiceFieldsUnchanged()
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && (
          request.resource.data.handle == resource.data.handle
          || (
            // Changing a handle is delete-old + create-new + update-profile in
            // one batch. Both halves are checked so an account cannot end up
            // holding two reservations.
            getAfter(
              /databases/$(database)/documents/handles/$(request.resource.data.handle)
            ).data.uid == request.auth.uid
            && !existsAfter(
              /databases/$(database)/documents/handles/$(resource.data.handle)
            )
          )
        );
      // Deleting a profile has to free its reservation in the same batch.
      // Without this an account could delete-and-recreate its way to an
      // unlimited pile of handles: the `!existsAfter` guard on update only
      // covers renaming, not this path.
      allow delete: if (request.auth != null
          && request.auth.uid == profileUid
          && !existsAfter(
            /databases/$(database)/documents/handles/$(resource.data.handle)
          ))
        || isAdmin();
    }

    match /handles/{handle} {
      // Resolving /public/user/{handle} to a uid must work signed out — by
      // exact id. `list` stays shut so the reservation table cannot be dumped
      // as a handle-to-uid directory.
      allow get: if true;
      allow list: if false;
      // Create-only on purpose. Firestore refuses a create when the document
      // already exists and there is no update rule here, so an occupied
      // handle can never change hands in place: that is the uniqueness
      // guarantee, enforced by the database rather than by a client check.
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && validHandleSegment(handle)
        && getAfter(
          /databases/$(database)/documents/userProfiles/$(request.auth.uid)
        ).data.handle == handle;
      allow delete: if (request.auth != null
          && resource.data.uid == request.auth.uid)
        || isAdmin();
    }

    match /users/{userId} {
      allow read, delete: if ownsUserTree(userId);
      allow create, update: if ownsUserTree(userId)
        && request.resource.data.keys().hasOnly(userProfileKeys().concat(frozenUserKeys()))
        && frozenUserFieldsUntouched()
        && (!('onboardingComplete' in request.resource.data)
          || request.resource.data.onboardingComplete is bool)
        && (!('preferences' in request.resource.data)
          || request.resource.data.preferences is list
            && request.resource.data.preferences.size() <= 100)
        && (!('selectedCategories' in request.resource.data)
          || request.resource.data.selectedCategories is list
            && request.resource.data.selectedCategories.size() <= 100)
        && (!('followedAuthors' in request.resource.data)
          || request.resource.data.followedAuthors is list
            && request.resource.data.followedAuthors.size() <= 100)
        && (!('readingPreferences' in request.resource.data)
          || request.resource.data.readingPreferences is map
            && request.resource.data.readingPreferences.keys().hasOnly([
              'aiExplanationLevel', 'language', 'languagePreferenceSet'
            ])
            && (!('aiExplanationLevel' in request.resource.data.readingPreferences)
              || request.resource.data.readingPreferences.aiExplanationLevel in [
                'beginner', 'university', 'researcher'
              ])
            && (!('language' in request.resource.data.readingPreferences)
              || request.resource.data.readingPreferences.language in ['es', 'en'])
            && (!('languagePreferenceSet' in request.resource.data.readingPreferences)
              || request.resource.data.readingPreferences.languagePreferenceSet is bool))
        && (!('profilePhoto' in request.resource.data)
          || validString(request.resource.data.profilePhoto, 280000))
        && (!('emailDigestOptIn' in request.resource.data)
          || request.resource.data.emailDigestOptIn is bool);

      // Where pinned lists wait while "show pinned lists" is off (F8).
      //
      // Firestore has no field-level security: hiding the pins means the array
      // cannot stay in the world-readable profile document at all, so it is
      // parked here. It is a subcollection rather than a field on users/{uid}
      // because when it was written that document was unwritable on every
      // account of an early vintage — the legacy-key bug fixed just above.
      // That second reason has expired. The shape stays: it is owner-only
      // either way, and moving a working, already-deployed store would gain
      // nothing.
      match /profileStash/{stashId} {
        allow read, delete: if ownsUserTree(userId);
        allow create, update: if ownsUserTree(userId)
          && request.resource.data.keys().hasOnly(['pinnedLists', 'updatedAt'])
          && request.resource.data.pinnedLists is list
          && request.resource.data.pinnedLists.size() <= 6;
      }

      // No `request.query.limit` ceiling here, unlike `highlights` above and
      // every other listable collection under this tree — deliberately, and for
      // a reason that does not apply to the others.
      //
      // Every client query against this collection is
      // `where(documentId(), 'in', [...])`. That filter is itself the ceiling:
      // Firestore refuses more than thirty comparison values, measured (31
      // returns `invalid-argument: 'IN' supports up to 30 comparison values.`),
      // so a caller cannot read more than thirty documents per query no matter
      // what it asks for. The read amplification a limit clause exists to stop
      // is already impossible.
      //
      // Adding the clause anyway would not be free: it would refuse every
      // existing caller that omits `limit()`, which is all of them, and the
      // refusal arrives at the user as the same generic "could not load" as a
      // flaky network. If a caller is ever added that lists this collection
      // WITHOUT an `in` filter, this exception stops applying and the ceiling
      // has to come back.
      match /interactions/{paperId} {
        allow read, delete: if ownsUserTree(userId);
        allow create, update: if ownsUserTree(userId)
          && request.resource.data.keys().hasOnly([
            'liked', 'notInterested', 'saved', 'read', 'readLater', 'openedPdf',
            'viewTime', 'skip', 'pdfBounce', 'paperTitle', 'paperAuthors',
            'paperCategory', 'paperAbstract', 'paper', 'timestamp', 'readAt',
            'libraryUpdatedAt', 'deviceType', 'context', 'note', 'tags'
          ])
          && (!('paperTitle' in request.resource.data)
            || validString(request.resource.data.paperTitle, 1000))
          && (!('paperAbstract' in request.resource.data)
            || validString(request.resource.data.paperAbstract, 1000))
          && (!('paperCategory' in request.resource.data)
            || validString(request.resource.data.paperCategory, 160))
          && (!('note' in request.resource.data) || validString(request.resource.data.note, 10000))
          && (!('tags' in request.resource.data)
            || request.resource.data.tags is list && request.resource.data.tags.size() <= 12)
          && (!('paperAuthors' in request.resource.data)
            || request.resource.data.paperAuthors is list && request.resource.data.paperAuthors.size() <= 20)
          && (!('paper' in request.resource.data) || request.resource.data.paper is map);
      }

      // Derived aggregate of the interactions subcollection above, so a feed
      // load costs one read instead of one per paper the account ever saw.
      // Everything here is reconstructible from `interactions`, which stays the
      // source of truth, so the client may write it directly as long as the
      // shape and every payload size stay bounded. Without the caps a client
      // could park an arbitrarily large blob in its own tree.
      match /aggregates/{aggregateId} {
        allow read, delete: if ownsUserTree(userId) && aggregateId == 'interactions';
        allow create, update: if ownsUserTree(userId)
          && aggregateId == 'interactions'
          && request.resource.data.keys().hasOnly([
            'schemaVersion', 'updatedAt', 'affinities', 'curated', 'seenFilter',
            'interactionCount', 'evictedCount', 'sourceDocCount', 'truncated'
          ])
          && request.resource.data.keys().hasAll([
            'schemaVersion', 'updatedAt', 'affinities', 'curated'
          ])
          && request.resource.data.schemaVersion is int
          && request.resource.data.schemaVersion >= 1
          && request.resource.data.schemaVersion <= 1000
          && validString(request.resource.data.updatedAt, 40)
          // Category cohort sums; ~50 buckets per category, 300 categories max.
          && validString(request.resource.data.affinities, 120000)
          // Exact paper ids for the sets that render in the UI.
          && validString(request.resource.data.curated, 320000)
          // Base64 Bloom filter: 479264 bits is 79880 chars, and the cap leaves
          // room for nothing larger than that to be stored.
          && (!('seenFilter' in request.resource.data)
            || validString(request.resource.data.seenFilter, 120000))
          // Belt and braces on the 1 MiB document limit: the two required
          // payloads together, plus the filter's own cap above, bound the whole
          // document at 560000 characters.
          && request.resource.data.affinities.size()
            + request.resource.data.curated.size() <= 440000
          && (!('interactionCount' in request.resource.data)
            || request.resource.data.interactionCount is int
              && request.resource.data.interactionCount >= 0)
          && (!('evictedCount' in request.resource.data)
            || request.resource.data.evictedCount is int
              && request.resource.data.evictedCount >= 0)
          && (!('sourceDocCount' in request.resource.data)
            || request.resource.data.sourceDocCount is int
              && request.resource.data.sourceDocCount >= 0)
          && (!('truncated' in request.resource.data)
            || request.resource.data.truncated is bool);
      }

      match /following/{followId} {
        allow read, delete: if ownsUserTree(userId);
        allow create, update: if ownsUserTree(userId)
          && request.resource.data.keys().hasOnly([
            'type', 'canonicalId', 'displayName', 'source', 'externalIds',
            'metadata', 'followedAt', 'followKey'
          ])
          && request.resource.data.type in ['author', 'topic', 'institution', 'project']
          && validString(request.resource.data.canonicalId, 500)
          && validString(request.resource.data.displayName, 500)
          && (!('source' in request.resource.data) || validString(request.resource.data.source, 80))
          && (!('externalIds' in request.resource.data) || request.resource.data.externalIds is map)
          && (!('metadata' in request.resource.data) || request.resource.data.metadata is map);
      }

      match /settings/followingUpdates {
        allow read, delete: if ownsUserTree(userId);
        allow create, update: if ownsUserTree(userId)
          && request.resource.data.keys().hasOnly(['seenIds', 'updatedAt'])
          && request.resource.data.seenIds is list
          && request.resource.data.seenIds.size() <= 500;
      }

      // `publicShareId` is the pointer from a private list to its public copy,
      // and after F11 only the Worker may move it: it sets the field in the same
      // commit that creates both public documents, and clears it in the same
      // commit that deletes them. That makes "the field is present" and "the
      // public documents exist" the same fact, which is what the delete rule
      // below leans on. Same shape as frozenUserFieldsUntouched() above.
      function publicShareIdUntouched() {
        return resource == null
          ? !('publicShareId' in request.resource.data)
          : !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['publicShareId']);
      }

      match /lists/{listId} {
        allow read: if ownsUserTree(userId);
        // Deleting a published list still has to be impossible — an orphaned
        // public document is unreachable and uneditable forever.
        //
        // It used to be spelled with two existsAfter() calls, satisfied by the
        // client deleting all three documents in one batch. The client can no
        // longer delete the public two, so that spelling would have locked
        // every published list in place permanently. This asks the equivalent
        // question of the private document alone: unpublish first (the Worker
        // clears the pointer), then delete.
        allow delete: if ownsUserTree(userId)
          && !('publicShareId' in resource.data);
        allow create, update: if ownsUserTree(userId)
          && request.resource.data.keys().hasOnly([
            'id', 'name', 'emoji', 'color', 'paperIds', 'createdAt', 'publicShareId',
            // F12: `onProfile` and `publicSyncedAt` are stamped by the Worker
            // (attribution mirror and last-sync marker); `updatedAt` by the
            // client on each edit. They are tolerated rather than protected:
            // faking any of them only miscolors the owner's own badges and
            // mutes the owner's own stale-link indicator — self-harm, and a
            // freeze clause here would spend lists/ budget buying nothing.
            'onProfile', 'updatedAt', 'publicSyncedAt'
          ])
          && validString(request.resource.data.name, 120)
          && validString(request.resource.data.emoji, 40)
          // The 0.2 palette. Optional: lists made before it carry no colour and
          // the client derives one from the id. Ids, not hex values, and only
          // the eight the picker offers — mirrored by hand from LIST_COLORS in
          // src/utils/listColors.js; the rules test ties the two lists together.
          && (!('color' in request.resource.data)
            || request.resource.data.color in [
              'ochre', 'olive', 'green', 'teal', 'blue', 'indigo', 'violet', 'crimson'
            ])
          && request.resource.data.paperIds is list
          && request.resource.data.paperIds.size() <= 500
          && (!('onProfile' in request.resource.data)
            || request.resource.data.onProfile is bool)
          && (!('updatedAt' in request.resource.data)
            || request.resource.data.updatedAt is timestamp)
          && (!('publicSyncedAt' in request.resource.data)
            || request.resource.data.publicSyncedAt is timestamp)
          && publicShareIdUntouched()
          // Belt and braces: the value can only have come from the Worker, but
          // a document of unknown vintage still has to look like a share id.
          && (!('publicShareId' in request.resource.data)
            || validString(request.resource.data.publicShareId, 32)
              && request.resource.data.publicShareId.matches('^[a-f0-9]{32}$'));
      }

      // No `request.query.limit` ceiling here, unlike `highlights` above and
      // every other listable collection under this tree — deliberately, and for
      // a reason that does not apply to the others.
      //
      // Every client query against this collection is
      // `where(documentId(), 'in', [...])`. That filter is itself the ceiling:
      // Firestore refuses more than thirty comparison values, measured (31
      // returns `invalid-argument: 'IN' supports up to 30 comparison values.`),
      // so a caller cannot read more than thirty documents per query no matter
      // what it asks for. The read amplification a limit clause exists to stop
      // is already impossible.
      //
      // Adding the clause anyway would not be free: it would refuse every
      // existing caller that omits `limit()`, which is all of them, and the
      // refusal arrives at the user as the same generic "could not load" as a
      // flaky network. If a caller is ever added that lists this collection
      // WITHOUT an `in` filter, this exception stops applying and the ceiling
      // has to come back.
      match /savedPapers/{paperId} {
        allow read, delete: if ownsUserTree(userId);
        allow create, update: if ownsUserTree(userId)
          && request.resource.data.keys().hasOnly([
            'title', 'authors', 'primaryCategory', 'published', 'arxivId',
            'summary', 'doi', 'landingPageUrl', 'savedAt'
          ])
          && validString(request.resource.data.title, 1000)
          && (!('authors' in request.resource.data)
            || request.resource.data.authors is list && request.resource.data.authors.size() <= 20)
          && (!('summary' in request.resource.data)
            || validString(request.resource.data.summary, 1000))
          && (!('doi' in request.resource.data)
            || request.resource.data.doi == null
            || validString(request.resource.data.doi, 300))
          && (!('landingPageUrl' in request.resource.data)
            || request.resource.data.landingPageUrl == null
            || validString(request.resource.data.landingPageUrl, 2000));
      }

      // Reader highlights. Anchored by quote rather than by character offset so
      // they survive a regenerated rewrite, which is why `quote` is required.
      //
      // `paperId` and `sectionId` are checked non-empty, not merely bounded:
      // both are part of the FNV-1a fingerprint that `buildHighlightId` turns
      // into the document id, and `listUserHighlights` filters by `paperId`. An
      // empty one produces a highlight that belongs to no paper and no section,
      // which `userHighlightService.normalizeUserHighlight` already refuses to
      // write — so this is the same refusal, one layer down. `paperTitle` is
      // deliberately NOT in that group: the service writes `''` whenever the
      // title is unknown, and a rule requiring it would deny that write.
      //
      // `createdAt` was in the allowlist with no check at all, so any value —
      // a string, a date in 2019 — went in unchallenged. Pinning it to
      // `request.time` is what `serverTimestamp()` resolves to, so the only
      // writer in the app keeps working, and no other stamp is writable. It
      // also makes the field mandatory, which it already was in practice.
      //
      // Not frozen on update, unlike a createdAt elsewhere would be:
      // `saveUserHighlight` re-saves the whole document with `setDoc` and a
      // fresh `serverTimestamp()`, so freezing it would deny re-saving a
      // selection. The consequence is that a partial `updateDoc` — say, to edit
      // `note` — has to re-stamp `createdAt` too, since a merged write carrying
      // the stored value forward is not `request.time`. Nothing does that today.
      // The field is private to its owner, so a timestamp here cannot tell
      // anyone else who edited most recently.
      match /highlights/{highlightId} {
        allow get, delete: if ownsUserTree(userId);
        // Every sibling collection under this tree carries its page ceiling in
        // the rules; this one shipped without any, so `read` covered `list` and
        // `ownsUserTree` never looks at `request.query`. The collection is the
        // caller's own, so an unbounded list is not a leak — it is a bill: one
        // document read per highlight the account has ever made, every time a
        // paper opens. `listUserHighlights` now asks for
        // `where('paperId', '==', ...)` capped at MAX_HIGHLIGHTS_PER_PAPER
        // (200, in src/services/userHighlightService.js); the same number is
        // repeated here because a ceiling that lives only in the client is a
        // convention, and the read amplification it removes comes back the
        // moment any client forgets it.
        allow list: if ownsUserTree(userId) && request.query.limit <= 200;
        allow create, update: if ownsUserTree(userId)
          && request.resource.data.keys().hasOnly([
            'paperId', 'level', 'language', 'sectionId', 'paragraphIndex',
            'quote', 'kind', 'note', 'paperTitle', 'createdAt'
          ])
          && validNonEmptyString(request.resource.data.paperId, 400)
          && validString(request.resource.data.quote, 400)
          && request.resource.data.quote.size() >= 8
          && validNonEmptyString(request.resource.data.sectionId, 40)
          && request.resource.data.createdAt == request.time
          // The id is a fingerprint of paperId among other fields, so a write
          // that moves an existing highlight to a different paper leaves a
          // document `buildHighlightId` could never have produced: it would
          // then surface under the new paper while `removeUserHighlight` and
          // the save-time de-duplication both still address the old id. Re-
          // saving the same selection carries the same paperId, so the only
          // writes this refuses are the ones that were already incoherent.
          && (resource == null
            || request.resource.data.paperId == resource.data.paperId)
          && request.resource.data.paragraphIndex is int
          && request.resource.data.paragraphIndex >= 0
          && request.resource.data.paragraphIndex <= 100
          && request.resource.data.level in ['beginner', 'university', 'researcher']
          && request.resource.data.language in ['es', 'en']
          // 'ai' joins the list rather than arriving as a second `origin`
          // field: `kind` already answers "what sort of mark is this", the mark
          // colour and the annotation's origin are the same fact, and a new
          // field would have cost a new clause in a rule whose expression
          // budget is already measured.
          && (!('kind' in request.resource.data)
            || request.resource.data.kind in ['user', 'ai', 'finding', 'method', 'caveat', 'number'])
          && (!('note' in request.resource.data)
            || validString(request.resource.data.note, 2000))
          && (!('paperTitle' in request.resource.data)
            || validString(request.resource.data.paperTitle, 1000));
      }

      match /{document=**} {
        allow read, write: if false;
      }
    }

    // ---------------------------------------------------------------------
    // F12: the showcase of attributed lists. Additive: nothing above this
    // line changes. Kept at the end of the file on purpose.
    // ---------------------------------------------------------------------

    match /profileLists/{profileUid} {
      // The cards of this account's published-and-attributed lists, written
      // ONLY by the Worker in the same commit that publishes, updates,
      // attributes or unpublishes — which is why writes cost these rules
      // nothing and why no validation of the cards lives here.
      //
      // Reading follows the profile's own visibility: the owner always may
      // (that branch short-circuits before the get), anyone else only while
      // the profile is public. The get() is billed as one read per fetch;
      // it is what lets going private hide the showcase with zero writes and
      // zero new clauses on the profile write path — the client cannot be
      // asked to delete in its batch a document it cannot write.
      allow get: if (request.auth != null && request.auth.uid == profileUid)
        || profileIsPublic(
          get(/databases/$(database)/documents/userProfiles/$(profileUid)).data
        );
      // No directory of showcases: the only path in is a profile you can
      // already read.
      allow list: if false;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
