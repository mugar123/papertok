rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function ownsUserTree(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function validString(value, maximum) {
      return value is string && value.size() <= maximum;
    }

    function validBoundedStringList(values, maximumItems, maximumLength) {
      return values is list
        && values.size() <= maximumItems
        && (values.size() < 1 || validString(values[0], maximumLength))
        && (values.size() < 2 || validString(values[1], maximumLength))
        && (values.size() < 3 || validString(values[2], maximumLength))
        && (values.size() < 4 || validString(values[3], maximumLength))
        && (values.size() < 5 || validString(values[4], maximumLength))
        && (values.size() < 6 || validString(values[5], maximumLength))
        && (values.size() < 7 || validString(values[6], maximumLength))
        && (values.size() < 8 || validString(values[7], maximumLength))
        && (values.size() < 9 || validString(values[8], maximumLength))
        && (values.size() < 10 || validString(values[9], maximumLength))
        && (values.size() < 11 || validString(values[10], maximumLength))
        && (values.size() < 12 || validString(values[11], maximumLength))
        && (values.size() < 13 || validString(values[12], maximumLength))
        && (values.size() < 14 || validString(values[13], maximumLength))
        && (values.size() < 15 || validString(values[14], maximumLength))
        && (values.size() < 16 || validString(values[15], maximumLength))
        && (values.size() < 17 || validString(values[16], maximumLength))
        && (values.size() < 18 || validString(values[17], maximumLength))
        && (values.size() < 19 || validString(values[18], maximumLength))
        && (values.size() < 20 || validString(values[19], maximumLength));
    }

    // ---------------------------------------------------------------------
    // Public lists (F11). Server-written, and that is the whole design.
    //
    // These documents used to be validated here, per paper, from the client.
    // They cannot be: the rules engine stops at 1000 evaluated expressions per
    // request and ONE realistic paper already exceeded that budget, so
    // publishing was refused outright in production. Measured in
    // tests/p18-measure.test.js, with the ceiling for every trimmed variant —
    // no honest trim left the product cap above six papers.
    //
    // So the write moved to the Worker, which validates in real code with the
    // service identity (`worker/public-list-api.js`) and holds the single
    // definition of a valid public list in `src/services/publicListPayload.js`,
    // the same module the browser imports. Here, only two things remain true:
    // anyone may read a share link, and nobody may write one.
    //
    // `publicListOwners` stays unreadable and unwritable from the client. It is
    // still read by these rules themselves — `ownsPinnedShare` below — because a
    // rules-internal get() is not an `allow read`.
    function userProfileKeys() {
      return [
        'onboardingComplete',
        'preferences',
        'selectedCategories',
        'followedAuthors',
        'followingMigratedAt',
        'readingPreferences',
        'profilePhoto'
      ];
    }

    // Fields an early version of the app wrote into users/{uid} and nothing has
    // written since; every one of them is a copy of the Firebase Auth record,
    // which stays the source of truth. They are here because every write the
    // app makes to that document is a merge, so `request.resource.data` is the
    // whole merged document: an allowlist that does not name them denies every
    // write on an account of that vintage, which is what it did.
    //
    // Tolerated, not writable — see legacyUserFieldsUntouched().
    function legacyUserKeys() {
      return ['email', 'displayName', 'photoURL', 'createdAt'];
    }

    // A write may carry the legacy fields along unchanged; it may not add, edit
    // or drop one. So an account that has them keeps exactly the values it has,
    // an account that does not can never acquire them, and tolerating the four
    // keys above does not hand the account holder a writable `email` in a
    // document that reads like identity. Deleting them is the backfill's job,
    // and a backfill runs with a service identity, past these rules.
    function legacyUserFieldsUntouched() {
      return resource == null
        ? !request.resource.data.keys().hasAny(legacyUserKeys())
        : !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(legacyUserKeys());
    }

    match /publicLists/{shareId} {
      // A share link is public, as it always was: one document, one read.
      allow get: if true;
      // Paging is not. `allow read` covered both, so anyone could have walked
      // the whole collection and harvested every list ever published — a
      // directory the product never offers. Nothing reads it that way: the page
      // fetches one share id, and profile pins render from the profile.
      allow list: if false;
      // Every write comes from the Worker, past these rules entirely.
      allow write: if false;
    }

    match /publicListOwners/{shareId} {
      allow read: if false;
      allow write: if false;
    }

    // ---------------------------------------------------------------------
    // Public user profiles (F1). Additive: nothing above this line changes.
    // ---------------------------------------------------------------------

    function isAdmin() {
      // The moderation queue landed with F3, so the placeholder gave way to
      // the real thing: @mugar's uid, resolved from handles/mugar. A uid is
      // not a secret. Changing admins is editing this line and deploying.
      return request.auth != null
        && request.auth.uid == 'SrqikE0wbtPOsTZMnvK4lcLVHhD3';
    }

    // Handles that would collide with an application route or let an account
    // pose as staff. Kept identical to RESERVED_HANDLES in
    // src/utils/userHandle.js; userHandle.test.js fails if the two drift.
    function reservedHandles() {
      return [
        'about', 'admin', 'administrator', 'api', 'assets', 'auth',
        'contact', 'docs', 'entity', 'explorer', 'feed', 'following', 'help',
        'legal', 'list', 'lists', 'login', 'logout', 'me', 'moderator',
        'onboarding', 'paper', 'papers', 'papertok', 'privacy', 'profile',
        'public', 'register', 'report', 'research', 'root', 'search',
        'security', 'settings', 'signin', 'signup', 'staff', 'support',
        'system', 'team', 'terms', 'user', 'users', 'www'
      ];
    }

    function validHandleSegment(handle) {
      return handle.matches('^[a-z0-9_]{3,40}$')
        && handle.matches('^[a-z0-9_]*[a-z][a-z0-9_]*$')
        && !(handle in reservedHandles());
    }

    // Ownership of a pinned share, in ONE document access.
    //
    // The obvious form spends two (exists + get); at eight pinned lists that
    // would be sixteen and blow the ten-call ceiling for a single-document
    // request. A missing owner document makes `get()` return null, and reading
    // `.data` off null denies the write — which is the outcome we want for a
    // share id that does not exist.
    function ownsPinnedShare(shareId) {
      return get(/databases/$(database)/documents/publicListOwners/$(shareId))
        .data.ownerId == request.auth.uid;
    }

    // A pinned list is a denormalized card: enough to render the profile
    // without reading publicLists, and nothing else. The public list document
    // itself is never touched by pinning — but the pin must be the owner's own
    // list, or attribution would be forgeable by anyone who knows a share id.
    function validPinnedList(entry) {
      return entry.keys().hasOnly(['shareId', 'title', 'emoji', 'paperCount'])
        && entry.shareId is string
        && entry.shareId.matches('^[a-f0-9]{32}$')
        && entry.title is string
        && entry.title.size() > 0
        && entry.title.size() <= 120
        && (!('emoji' in entry)
          || entry.emoji is string && entry.emoji.size() <= 40)
        && entry.paperCount is int
        && entry.paperCount >= 0
        && entry.paperCount <= 12
        && ownsPinnedShare(entry.shareId);
    }

    // Six, and the ceiling is measured, not chosen.
    //
    // Every entry costs one get() for its ownership check, but the binding
    // limit turned out to be the 1000-expression budget per rule evaluation,
    // not the 10-document-access one: against the emulator, seven pins pass and
    // eight fail outright with an expression-limit error. Six leaves one entry
    // of slack so that the next clause added to this file — F2 follows, F6
    // orcid — does not silently start rejecting saves for anyone sitting at the
    // cap. `tests/firestore.rules.test.js` pins both the cap and the headroom.
    function validPinnedLists(entries) {
      return entries is list
        && entries.size() <= 6
        && (entries.size() < 1 || validPinnedList(entries[0]))
        && (entries.size() < 2 || validPinnedList(entries[1]))
        && (entries.size() < 3 || validPinnedList(entries[2]))
        && (entries.size() < 4 || validPinnedList(entries[3]))
        && (entries.size() < 5 || validPinnedList(entries[4]))
        && (entries.size() < 6 || validPinnedList(entries[5]));
    }

    // orcid, verified and followerCount are written only by the service
    // identity (F6/F2), which bypasses rules. Declaring them untouchable for
    // clients here is the guarantee that a user cannot mark themselves verified
    // or award themselves followers. They stay in the hasOnly allowlist so that
    // a client update carrying the merged document is not rejected outright.
    function publicProfileServiceFieldsAbsent() {
      return !('orcid' in request.resource.data)
        && !('followerCount' in request.resource.data)
        && (!('verified' in request.resource.data)
          || request.resource.data.verified == false);
    }

    function publicProfileServiceFieldsUnchanged() {
      return ('orcid' in request.resource.data) == ('orcid' in resource.data)
        && (!('orcid' in resource.data)
          || request.resource.data.orcid == resource.data.orcid)
        && ('verified' in request.resource.data) == ('verified' in resource.data)
        && (!('verified' in resource.data)
          || request.resource.data.verified == resource.data.verified)
        && ('followerCount' in request.resource.data)
          == ('followerCount' in resource.data)
        && (!('followerCount' in resource.data)
          || request.resource.data.followerCount == resource.data.followerCount);
    }

    // Profile visibility (F8). A string rather than a boolean, and absence is
    // load-bearing: a document written before this phase has no `visibility`
    // and MUST keep reading as public. An absent boolean would coerce to false
    // and silently take every existing profile private, which is the one
    // outcome this design refuses.
    function profileIsPublic(data) {
      return !('visibility' in data) || data.visibility == 'public';
    }

    // The search index (F9) and the profile it mirrors are kept coherent from
    // both sides. This is the fail-safe side: a profile that is private after
    // the write must have no index document after the write either, so going
    // private cannot leave a stale entry behind. `existsAfter` looks at the
    // post-batch state, which is what makes "leave and delist in one batch"
    // the only accepted shape.
    function searchIndexAbsentAfter(uid) {
      return !existsAfter(/databases/$(database)/documents/userSearch/$(uid));
    }

    // And this is the other side, which the first version of F9 left open.
    //
    // `validUserSearchEntry` checks `nameLower == displayName.lower()` when the
    // ENTRY is written. On its own that is a gate you walk through once and then
    // walk away from: index yourself legally as "taylor swift" while your
    // profile really says it, then rename the profile without touching the
    // entry. Nothing refused either write, and the index kept advertising a name
    // the profile no longer held — the exact name-stuffing the equality exists
    // to stop, executed in two writes instead of one. The same two-step drifted
    // the handle, leaving a row that opens somebody else's profile once the
    // freed handle is claimed.
    //
    // So a public write now has to leave the entry agreeing with the profile it
    // produces. The comparison is `displayName.lower()`, byte for byte the one
    // already inside validUserSearchEntry: no second derivation exists that
    // could disagree with toIndexedName.
    //
    // An account with no entry is untouched — `existsAfter` is false and the
    // clause passes — which is what keeps every profile written before F9
    // saveable, and what makes this deployable without waiting for the app.
    function searchIndexCoherentAfter(uid) {
      return !existsAfter(/databases/$(database)/documents/userSearch/$(uid))
        || (getAfter(/databases/$(database)/documents/userSearch/$(uid)).data.nameLower
              == request.resource.data.displayName.lower()
            && getAfter(/databases/$(database)/documents/userSearch/$(uid)).data.handle
              == request.resource.data.handle);
    }

    // Measured, because this is where the expression budget goes. With the
    // coherence branch in place the heaviest legitimate profile write — rename
    // the handle, six pins, entry carried along — tops out at SIX pinned lists;
    // without it, seven. The cap stays at six and every legitimate write at the
    // cap still passes, but the one entry of slack F1 deliberately left is now
    // spent: the next clause added here takes the cap to five.
    // `tests/firestore.rules.test.js` measures both numbers so neither can move
    // unnoticed.
    function profileSearchStateValid(uid) {
      return profileIsPublic(request.resource.data)
        ? searchIndexCoherentAfter(uid)
        : searchIndexAbsentAfter(uid);
    }

    function validPublicProfile() {
      return request.resource.data.keys().hasOnly([
          'handle', 'displayName', 'bio', 'photo', 'orcid', 'verified',
          'allowContact', 'visibility', 'showPinnedLists', 'pinnedLists',
          'followerCount',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'handle', 'displayName', 'pinnedLists', 'createdAt', 'updatedAt'
        ])
        && validString(request.resource.data.handle, 40)
        // Grammar only. The reserved-name check lives on handles/{handle},
        // which every handle here must be backed by; repeating its 44-item
        // list on each profile write costs expression budget for nothing.
        && request.resource.data.handle.matches('^[a-z0-9_]{3,40}$')
        && validString(request.resource.data.displayName, 80)
        && request.resource.data.displayName.size() > 0
        && (!('bio' in request.resource.data)
          || validString(request.resource.data.bio, 500))
        // The recompressed public photo, not the 280 KB private one.
        && (!('photo' in request.resource.data)
          || validString(request.resource.data.photo, 60000))
        && (!('allowContact' in request.resource.data)
          || request.resource.data.allowContact is bool)
        && (!('visibility' in request.resource.data)
          || request.resource.data.visibility in ['public', 'private'])
        // Presentation state, not a disclosure boundary: hiding the pins means
        // `pinnedLists` is empty here and the entries are parked in the
        // owner-only document (Firestore has no field-level security, so the
        // array itself has to leave). This flag exists so that "no pins" and
        // "pins hidden" survive a reload as different states.
        && (!('showPinnedLists' in request.resource.data)
          || request.resource.data.showPinnedLists is bool)
        && validPinnedLists(request.resource.data.pinnedLists)
        && (!('followerCount' in request.resource.data)
          || request.resource.data.followerCount is int
            && request.resource.data.followerCount >= 0)
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    match /userProfiles/{profileUid} {
      // A public profile page has to render for a signed-out reader, and
      // resolving a handle must not require a session. A private one is
      // readable by its owner and by nobody else — enforced here, at the data
      // layer, so "private" survives a caller that ignores the UI entirely.
      //
      // `get` only. `read` would also grant `list`, which lets anyone page
      // through the whole collection and walk off with the user directory,
      // photos included, billed to this project. Every read path in the app
      // addresses a profile by uid or resolves one through handles/.
      //
      // Not covered by going private, deliberately and stated in the UI: the
      // handle reservation stays readable (uniqueness has to be answerable, and
      // freeing the handle would make the switch one-way), lists published from
      // Mis listas stay public (they are anonymous by design — going private
      // removes the attribution, not the list), and the follow edges pointing
      // at this uid stay countable.
      allow get: if profileIsPublic(resource.data)
        || (request.auth != null && request.auth.uid == profileUid);
      allow list: if false;
      allow create: if request.auth != null
        && request.auth.uid == profileUid
        && validPublicProfile()
        && publicProfileServiceFieldsAbsent()
        // The choice is the feature, so a profile cannot come into existence
        // without it. Deployed only after every live client sends the field:
        // an older cached bundle creating a profile would otherwise be
        // refused. Updates stay exempt — legacy documents predate the field
        // and must keep being editable until their owner answers the prompt.
        && 'visibility' in request.resource.data
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        // The reservation has to land in the same batch, or the profile
        // claims a handle nobody holds.
        && existsAfter(
          /databases/$(database)/documents/handles/$(request.resource.data.handle)
        )
        // A profile born private must not be born indexed, and one born public
        // must not inherit an entry that says something else (F9).
        && profileSearchStateValid(profileUid);
      allow update: if request.auth != null
        && request.auth.uid == profileUid
        && validPublicProfile()
        && publicProfileServiceFieldsUnchanged()
        // Going private and staying in the search index is not an unlikely
        // bug: it is a write this database refuses. Neither is renaming out
        // from under an entry that keeps serving the old name (F9).
        && profileSearchStateValid(profileUid)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && (
          request.resource.data.handle == resource.data.handle
          || (
            // Changing a handle is delete-old + create-new + update-profile in
            // one batch. Both halves are checked so an account cannot end up
            // holding two reservations.
            getAfter(
              /databases/$(database)/documents/handles/$(request.resource.data.handle)
            ).data.uid == request.auth.uid
            && !existsAfter(
              /databases/$(database)/documents/handles/$(resource.data.handle)
            )
          )
        );
      // Deleting a profile has to free its reservation in the same batch.
      // Without this an account could delete-and-recreate its way to an
      // unlimited pile of handles: the `!existsAfter` guard on update only
      // covers renaming, not this path.
      allow delete: if (request.auth != null
          && request.auth.uid == profileUid
          && !existsAfter(
            /databases/$(database)/documents/handles/$(resource.data.handle)
          )
          // ...and takes its search entry with it, or the index keeps serving
          // a name whose profile no longer exists (F9).
          && searchIndexAbsentAfter(profileUid))
        || isAdmin();
    }

    match /handles/{handle} {
      // Resolving /public/user/{handle} to a uid must work signed out — by
      // exact id. `list` stays shut so the reservation table cannot be dumped
      // as a handle-to-uid directory.
      allow get: if true;
      allow list: if false;
      // Create-only on purpose. Firestore refuses a create when the document
      // already exists and there is no update rule here, so an occupied
      // handle can never change hands in place: that is the uniqueness
      // guarantee, enforced by the database rather than by a client check.
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && validHandleSegment(handle)
        && getAfter(
          /databases/$(database)/documents/userProfiles/$(request.auth.uid)
        ).data.handle == handle;
      allow delete: if (request.auth != null
          && resource.data.uid == request.auth.uid)
        || isAdmin();
    }

    // ---------------------------------------------------------------------
    // User search index (F9). Additive: nothing above this line changes
    // except the two `profilePublicOrDelisted` clauses on userProfiles/.
    // ---------------------------------------------------------------------
    //
    // Searching is enumerating — rules see a query's `limit` and `orderBy`, never
    // the values of its `where` — so this collection is designed around what an
    // enumerator walks away with, not around pretending they cannot walk. The
    // prize here is handle + lowercased name of people who chose to be public,
    // which `allow get` on the profile already serves one by one. No photo, no
    // bio: those are exactly what the F1 review closed `list` on userProfiles/
    // to protect, and they stay closed.
    //
    // Keyed by uid rather than by handle so the coherence checks below address
    // userProfiles/$(uid) through the same path segment, and so renaming a
    // handle is an update in place instead of a third delete+create in a batch
    // that already touches three documents.

    function searchProfileAfter(uid) {
      return getAfter(/databases/$(database)/documents/userProfiles/$(uid)).data;
    }

    function validUserSearchEntry(uid) {
      // The mutation pass is explicit about which clauses here carry weight
      // today. `hasOnly` does — deleting it lets a photo back in. `hasAll` does
      // not: it is covered by `hasOnly` plus the dereferences below (a missing
      // key errors and denies, the same belt-and-braces noted on
      // validFollowEdge). Neither do the two size checks, which are implied by
      // the equalities at the bottom — the profile fields they are compared
      // against are themselves bounded by validPublicProfile. The redundant ones
      // stay because they stop being redundant the moment a document arrives by
      // any path that did not go through those clauses: the service identity of
      // F6 writes profiles this ruleset does not validate.
      //
      // Two fields, and no timestamp. The entry used to carry `createdAt ==
      // request.time`, which the client rewrote on every profile save: a field
      // named for creation that actually moved on every edit, readable and
      // ORDERABLE by anyone who can query the collection. That is a
      // "who edited their profile most recently" listing the product never
      // offers, handed out for free. Nothing read it — `readRow` takes the
      // handle and the name — so it is gone rather than frozen.
      return request.resource.data.keys().hasOnly(['handle', 'nameLower'])
        && request.resource.data.keys().hasAll(['handle', 'nameLower'])
        && validString(request.resource.data.handle, 40)
        && validString(request.resource.data.nameLower, 80)
        // Only public profiles are in the index, checked after the batch: this
        // is the direction that makes "a private profile does not appear in
        // results" a property of the data instead of a filter a modified client
        // could skip. `getAfter` on a profile that does not exist yields null
        // and denies the write, so an entry can never outlive its profile.
        //
        // Explicitly public, not public-by-absence. A profile written before F8
        // has no `visibility` field and reads as public — correct for opening
        // its page, which was always public, and wrong for this: being listed in
        // a searchable index is a thing to be asked about, and that account was
        // never asked. It answers the one-time prompt F8 already shows, and then
        // it is indexed. Silence is not consent, so silence is not an entry.
        //
        // The presence check is redundant today and the mutation pass says so:
        // on a profile with no `visibility`, the equality below dereferences a
        // key that is not there, which errors and denies on its own. Removing
        // BOTH lines is killed, and removing only the equality is killed; only
        // this line is a free-standing survivor. It stays because the thing it
        // guards against is a refactor rather than a caller — the day
        // `searchProfileAfter` grows a `.get('visibility', 'public')` default,
        // the error disappears and public-by-absence walks silently back in.
        && 'visibility' in searchProfileAfter(uid)
        && searchProfileAfter(uid).visibility == 'public'
        && request.resource.data.handle == searchProfileAfter(uid).handle
        // The one clause without which this whole collection would be a
        // name-stuffing surface: the indexed name has to BE the real display
        // name, lowercased. Otherwise anyone could index themselves under
        // somebody else's name and surface in searches for them.
        && request.resource.data.nameLower == searchProfileAfter(uid).displayName.lower();
    }

    match /userSearch/{searchUid} {
      // `get` buys nothing: the profile itself is the document to read, by uid
      // or through handles/. Leaving it open would only add a second oracle for
      // "does this uid have a public profile".
      allow get: if false;
      // `list` IS the feature, and it is the only read here. A session is
      // required — it makes scraping cost a real account, which is blockable by
      // uid — and the server imposes the ceiling, the follows/ pattern, so no
      // caller can page the index at this project's expense.
      allow list: if request.auth != null
        && request.query.limit <= 20;
      allow create, update: if request.auth != null
        && request.auth.uid == searchUid
        && validUserSearchEntry(searchUid);
      // Always available to the owner, unconditionally: leaving the index has
      // to be possible in the same batch that takes the profile private, and a
      // delete that could be refused would make that batch unwritable.
      //
      // And to the admin, which the first version of F9 forgot. The admin
      // branch of the profile delete carries no delisting requirement, so a
      // profile removed by moderation left its entry behind — still serving
      // that account's name and handle to every searcher, still linking to a
      // profile that no longer exists. With no admin delete here, the only
      // account that could clear it was the one that had just been moderated
      // away. Same shape as the admin delete already on handles/.
      allow delete: if (request.auth != null && request.auth.uid == searchUid)
        || isAdmin();
    }

    // ---------------------------------------------------------------------
    // User follows (F2). Additive: nothing above this line changes.
    // ---------------------------------------------------------------------
    //
    // One document per edge, `follows/{followerUid}_{targetUid}`. The composite
    // id is the whole design: an edge cannot be duplicated (the second create
    // hits an existing document), unfollowing is a delete by id with no query,
    // and "does A follow B" is a single get rather than a search.
    //
    // Deliberately NOT `users/{uid}/following`: that subcollection is private,
    // owner-only, and models external entities (authors, topics) for the feed.
    // Follower lists have to be readable by other people, which a private
    // subcollection cannot offer without breaking its current contract.

    // A uid that cannot contain the separator, so `{follower}_{target}` maps
    // back to exactly one pair. Firebase Auth mints 28-character alphanumeric
    // uids, so this rejects nothing real; without it an account whose uid ended
    // in `_x` could squat the document another pair needs and permanently block
    // that follow.
    function validFollowUid(uid) {
      return uid is string && uid.matches('^[A-Za-z0-9-]{1,128}$');
    }

    function validFollowEdge(edgeId) {
      // `hasAll` is the house shape (02-SECURITY.md) but it is belt-and-braces
      // here, and the mutation pass says so: deleting it changes no outcome,
      // because every required key is dereferenced below and a missing key
      // denies the write on its own. Kept for the shape, not load-bearing.
      return request.resource.data.keys().hasOnly(['followerUid', 'targetUid', 'createdAt'])
        && request.resource.data.keys().hasAll(['followerUid', 'targetUid', 'createdAt'])
        && validFollowUid(request.resource.data.followerUid)
        && validFollowUid(request.resource.data.targetUid)
        // The follower is the caller, and the id agrees with the body: the id
        // is what makes the edge idempotent, so the two must not diverge.
        && request.resource.data.followerUid == request.auth.uid
        && edgeId == request.resource.data.followerUid + '_' + request.resource.data.targetUid
        // Following yourself would be a free +1 on your own follower count.
        && request.resource.data.targetUid != request.auth.uid
        // Only accounts with a public profile can be followed. There is no page
        // to follow otherwise, and it keeps the graph from filling with edges
        // pointing at uids that were never users.
        && exists(/databases/$(database)/documents/userProfiles/$(request.resource.data.targetUid))
        // ...and a profile that has gone private is not a page either. Edges
        // that already exist are left alone — this only stops new ones, so
        // going private never silently deletes somebody's follows. Unfollowing
        // stays open in every case: you must always be able to leave.
        && profileIsPublic(
          get(/databases/$(database)/documents/userProfiles/$(request.resource.data.targetUid)).data
        )
        && request.resource.data.createdAt == request.time;
    }

    match /follows/{edgeId} {
      // Both directions are public: a follower list is a public fact about a
      // public profile, and "do I follow this person" has to answer for the
      // signed-in visitor. Unlike userProfiles, `list` stays open — paging the
      // follower list IS the feature — but every query must carry a ceiling,
      // so no caller can ask for the whole graph on this project's bill.
      allow get: if true;
      allow list: if request.query.limit <= 1000;
      // The `!= null` is the same belt-and-braces as `hasAll`: a signed-out
      // caller already dies on `request.auth.uid` inside validFollowEdge.
      allow create: if request.auth != null && validFollowEdge(edgeId);
      // An edge has no mutable state. Re-following is a create against a
      // document that already exists, which Firestore refuses on its own.
      allow update: if false;
      allow delete: if request.auth != null
        && resource.data.followerUid == request.auth.uid;
    }

    match /users/{userId} {
      allow read, delete: if ownsUserTree(userId);
      allow create, update: if ownsUserTree(userId)
        && request.resource.data.keys().hasOnly(userProfileKeys().concat(legacyUserKeys()))
        && legacyUserFieldsUntouched()
        && (!('onboardingComplete' in request.resource.data)
          || request.resource.data.onboardingComplete is bool)
        && (!('preferences' in request.resource.data)
          || request.resource.data.preferences is list
            && request.resource.data.preferences.size() <= 100)
        && (!('selectedCategories' in request.resource.data)
          || request.resource.data.selectedCategories is list
            && request.resource.data.selectedCategories.size() <= 100)
        && (!('followedAuthors' in request.resource.data)
          || request.resource.data.followedAuthors is list
            && request.resource.data.followedAuthors.size() <= 100)
        && (!('readingPreferences' in request.resource.data)
          || request.resource.data.readingPreferences is map
            && request.resource.data.readingPreferences.keys().hasOnly([
              'aiExplanationLevel', 'language', 'languagePreferenceSet'
            ])
            && (!('aiExplanationLevel' in request.resource.data.readingPreferences)
              || request.resource.data.readingPreferences.aiExplanationLevel in [
                'beginner', 'university', 'researcher'
              ])
            && (!('language' in request.resource.data.readingPreferences)
              || request.resource.data.readingPreferences.language in ['es', 'en'])
            && (!('languagePreferenceSet' in request.resource.data.readingPreferences)
              || request.resource.data.readingPreferences.languagePreferenceSet is bool))
        && (!('profilePhoto' in request.resource.data)
          || validString(request.resource.data.profilePhoto, 280000));

      // Where pinned lists wait while "show pinned lists" is off (F8).
      //
      // Firestore has no field-level security: hiding the pins means the array
      // cannot stay in the world-readable profile document at all, so it is
      // parked here. It is a subcollection rather than a field on users/{uid}
      // because when it was written that document was unwritable on every
      // account of an early vintage — the legacy-key bug fixed just above.
      // That second reason has expired. The shape stays: it is owner-only
      // either way, and moving a working, already-deployed store would gain
      // nothing.
      match /profileStash/{stashId} {
        allow read, delete: if ownsUserTree(userId);
        allow create, update: if ownsUserTree(userId)
          && request.resource.data.keys().hasOnly(['pinnedLists', 'updatedAt'])
          && request.resource.data.pinnedLists is list
          && request.resource.data.pinnedLists.size() <= 6;
      }

      match /interactions/{paperId} {
        allow read, delete: if ownsUserTree(userId);
        allow create, update: if ownsUserTree(userId)
          && request.resource.data.keys().hasOnly([
            'liked', 'notInterested', 'saved', 'read', 'readLater', 'openedPdf',
            'viewTime', 'skip', 'pdfBounce', 'paperTitle', 'paperAuthors',
            'paperCategory', 'paperAbstract', 'paper', 'timestamp', 'readAt',
            'libraryUpdatedAt', 'deviceType', 'context', 'note', 'tags'
          ])
          && (!('paperTitle' in request.resource.data)
            || validString(request.resource.data.paperTitle, 1000))
          && (!('paperAbstract' in request.resource.data)
            || validString(request.resource.data.paperAbstract, 1000))
          && (!('paperCategory' in request.resource.data)
            || validString(request.resource.data.paperCategory, 160))
          && (!('note' in request.resource.data) || validString(request.resource.data.note, 10000))
          && (!('tags' in request.resource.data)
            || request.resource.data.tags is list && request.resource.data.tags.size() <= 12)
          && (!('paperAuthors' in request.resource.data)
            || request.resource.data.paperAuthors is list && request.resource.data.paperAuthors.size() <= 20)
          && (!('paper' in request.resource.data) || request.resource.data.paper is map);
      }

      // Derived aggregate of the interactions subcollection above, so a feed
      // load costs one read instead of one per paper the account ever saw.
      // Everything here is reconstructible from `interactions`, which stays the
      // source of truth, so the client may write it directly as long as the
      // shape and every payload size stay bounded. Without the caps a client
      // could park an arbitrarily large blob in its own tree.
      match /aggregates/{aggregateId} {
        allow read, delete: if ownsUserTree(userId) && aggregateId == 'interactions';
        allow create, update: if ownsUserTree(userId)
          && aggregateId == 'interactions'
          && request.resource.data.keys().hasOnly([
            'schemaVersion', 'updatedAt', 'affinities', 'curated', 'seenFilter',
            'interactionCount', 'evictedCount', 'sourceDocCount', 'truncated'
          ])
          && request.resource.data.keys().hasAll([
            'schemaVersion', 'updatedAt', 'affinities', 'curated'
          ])
          && request.resource.data.schemaVersion is int
          && request.resource.data.schemaVersion >= 1
          && request.resource.data.schemaVersion <= 1000
          && validString(request.resource.data.updatedAt, 40)
          // Category cohort sums; ~50 buckets per category, 300 categories max.
          && validString(request.resource.data.affinities, 120000)
          // Exact paper ids for the sets that render in the UI.
          && validString(request.resource.data.curated, 320000)
          // Base64 Bloom filter: 479264 bits is 79880 chars, and the cap leaves
          // room for nothing larger than that to be stored.
          && (!('seenFilter' in request.resource.data)
            || validString(request.resource.data.seenFilter, 120000))
          // Belt and braces on the 1 MiB document limit: the two required
          // payloads together, plus the filter's own cap above, bound the whole
          // document at 560000 characters.
          && request.resource.data.affinities.size()
            + request.resource.data.curated.size() <= 440000
          && (!('interactionCount' in request.resource.data)
            || request.resource.data.interactionCount is int
              && request.resource.data.interactionCount >= 0)
          && (!('evictedCount' in request.resource.data)
            || request.resource.data.evictedCount is int
              && request.resource.data.evictedCount >= 0)
          && (!('sourceDocCount' in request.resource.data)
            || request.resource.data.sourceDocCount is int
              && request.resource.data.sourceDocCount >= 0)
          && (!('truncated' in request.resource.data)
            || request.resource.data.truncated is bool);
      }

      match /following/{followId} {
        allow read, delete: if ownsUserTree(userId);
        allow create, update: if ownsUserTree(userId)
          && request.resource.data.keys().hasOnly([
            'type', 'canonicalId', 'displayName', 'source', 'externalIds',
            'metadata', 'followedAt', 'followKey'
          ])
          && request.resource.data.type in ['author', 'topic', 'institution', 'project']
          && validString(request.resource.data.canonicalId, 500)
          && validString(request.resource.data.displayName, 500)
          && (!('source' in request.resource.data) || validString(request.resource.data.source, 80))
          && (!('externalIds' in request.resource.data) || request.resource.data.externalIds is map)
          && (!('metadata' in request.resource.data) || request.resource.data.metadata is map);
      }

      match /settings/followingUpdates {
        allow read, delete: if ownsUserTree(userId);
        allow create, update: if ownsUserTree(userId)
          && request.resource.data.keys().hasOnly(['seenIds', 'updatedAt'])
          && request.resource.data.seenIds is list
          && request.resource.data.seenIds.size() <= 500;
      }

      // `publicShareId` is the pointer from a private list to its public copy,
      // and after F11 only the Worker may move it: it sets the field in the same
      // commit that creates both public documents, and clears it in the same
      // commit that deletes them. That makes "the field is present" and "the
      // public documents exist" the same fact, which is what the delete rule
      // below leans on. Same shape as legacyUserFieldsUntouched() above.
      function publicShareIdUntouched() {
        return resource == null
          ? !('publicShareId' in request.resource.data)
          : !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['publicShareId']);
      }

      match /lists/{listId} {
        allow read: if ownsUserTree(userId);
        // Deleting a published list still has to be impossible — an orphaned
        // public document is unreachable and uneditable forever.
        //
        // It used to be spelled with two existsAfter() calls, satisfied by the
        // client deleting all three documents in one batch. The client can no
        // longer delete the public two, so that spelling would have locked
        // every published list in place permanently. This asks the equivalent
        // question of the private document alone: unpublish first (the Worker
        // clears the pointer), then delete.
        allow delete: if ownsUserTree(userId)
          && !('publicShareId' in resource.data);
        allow create, update: if ownsUserTree(userId)
          && request.resource.data.keys().hasOnly([
            'id', 'name', 'emoji', 'paperIds', 'createdAt', 'publicShareId'
          ])
          && validString(request.resource.data.name, 120)
          && validString(request.resource.data.emoji, 40)
          && request.resource.data.paperIds is list
          && request.resource.data.paperIds.size() <= 500
          && publicShareIdUntouched()
          // Belt and braces: the value can only have come from the Worker, but
          // a document of unknown vintage still has to look like a share id.
          && (!('publicShareId' in request.resource.data)
            || validString(request.resource.data.publicShareId, 32)
              && request.resource.data.publicShareId.matches('^[a-f0-9]{32}$'));
      }

      match /savedPapers/{paperId} {
        allow read, delete: if ownsUserTree(userId);
        allow create, update: if ownsUserTree(userId)
          && request.resource.data.keys().hasOnly([
            'title', 'authors', 'primaryCategory', 'published', 'arxivId',
            'summary', 'doi', 'landingPageUrl', 'savedAt'
          ])
          && validString(request.resource.data.title, 1000)
          && (!('authors' in request.resource.data)
            || request.resource.data.authors is list && request.resource.data.authors.size() <= 20)
          && (!('summary' in request.resource.data)
            || validString(request.resource.data.summary, 1000))
          && (!('doi' in request.resource.data)
            || request.resource.data.doi == null
            || validString(request.resource.data.doi, 300))
          && (!('landingPageUrl' in request.resource.data)
            || request.resource.data.landingPageUrl == null
            || validString(request.resource.data.landingPageUrl, 2000));
      }

      match /{document=**} {
        allow read, write: if false;
      }
    }

    // ---------------------------------------------------------------------
    // F3: paper stubs, comments, throttle ledger, reports, killswitch.
    // Additive: nothing above this line changes. Kept at the end of the file
    // on purpose — a parallel branch is editing the users/ block above, and
    // this section must merge under it without touching it.
    // ---------------------------------------------------------------------

    // The emergency brake. `config/moderation` is a document the admin can
    // write from a phone, no deploy: while `commentsFrozen` is true, no stub
    // and no comment can be created anywhere in the app. Reads are memoized
    // per evaluation, so the check costs one read per create.
    function commentsFrozen() {
      return exists(/databases/$(database)/documents/config/moderation)
        && get(/databases/$(database)/documents/config/moderation)
          .data.get('commentsFrozen', false) == true;
    }

    // The declarative throttle (00-ARCHITECTURE.md). A social create must
    // carry, in its own batch, a write to users/{uid}/rateLimits/{action}
    // stamped with this request's time — and that document's own rules
    // (below) refuse the stamp before the interval has passed. Two documents,
    // one batch, no server.
    function throttleSatisfied(action) {
      return getAfter(
        /databases/$(database)/documents/users/$(request.auth.uid)/rateLimits/$(action)
      ).data.lastAt == request.time;
    }

    function validRateLimitDoc(action) {
      return (action == 'comments' || action == 'stubs' || action == 'reports')
        && request.resource.data.keys().hasOnly(['lastAt', 'count'])
        && request.resource.data.keys().hasAll(['lastAt', 'count'])
        // The stamp IS the mechanism: `throttleSatisfied` compares it against
        // request.time, so a backdated or future stamp must be unwritable.
        && request.resource.data.lastAt == request.time
        && request.resource.data.count is int
        && request.resource.data.count >= 0;
    }

    // Intervals per action, server-enforced. Coarse on purpose: this is the
    // free, always-on line against mechanical spam, not a daily quota (rules
    // cannot count). The escalation path if it proves too coarse is written
    // down in 00-ARCHITECTURE.md.
    function rateLimitIntervalElapsed(action) {
      return (action == 'comments'
          && request.time > resource.data.lastAt + duration.value(15, 's'))
        || (action == 'stubs'
          && request.time > resource.data.lastAt + duration.value(30, 's'))
        || (action == 'reports'
          && request.time > resource.data.lastAt + duration.value(60, 's'));
    }

    // A separate top-level match rather than a nested one inside the users/
    // block above, so the parallel branch editing that block never collides
    // with this file's tail. Overlapping matches are a union of grants:
    // the recursive deny inside users/ grants nothing and blocks nothing.
    match /users/{userId}/rateLimits/{action} {
      allow get: if ownsUserTree(userId);
      allow list: if false;
      // No delete, deliberately: deleting the ledger doc would reset the
      // clock, and the next create would sail through the interval.
      allow delete: if false;
      allow create: if ownsUserTree(userId) && validRateLimitDoc(action);
      allow update: if ownsUserTree(userId)
        && validRateLimitDoc(action)
        && rateLimitIntervalElapsed(action);
    }

    // The stub's identity field must agree with the identifiers it carries,
    // in canonical spelling (doi over arxiv, lowercase, no version): a client
    // cannot dress a key up as a DOI it does not have. What rules cannot
    // check is that the *document id* is base64url(canonicalKey) — there is
    // no base64 in this language — so a hostile client could park a stub
    // with mismatched id and key. That is the same defacement surface as
    // lying about the title (uncheckable here by nature), and it has the
    // same remedy: stubs are immutable to everyone but the admin, and a
    // `dup-stub` report routes the repair.
    function stubIdentityCoherent() {
      return ('doi' in request.resource.data)
        ? request.resource.data.canonicalKey == 'doi:' + request.resource.data.doi
        : (('arxivId' in request.resource.data)
          ? request.resource.data.canonicalKey == 'arxiv:' + request.resource.data.arxivId
          : (!request.resource.data.canonicalKey.matches('^doi:.*')
            && !request.resource.data.canonicalKey.matches('^arxiv:.*')));
    }

    function validPaperStub() {
      return request.resource.data.keys().hasOnly([
          'canonicalKey', 'title', 'authors', 'year', 'category', 'abstract',
          'doi', 'arxivId', 'openUrl', 'createdAt', 'createdBy'
        ])
        && request.resource.data.keys().hasAll([
          'canonicalKey', 'title', 'authors', 'createdAt', 'createdBy'
        ])
        && validString(request.resource.data.canonicalKey, 600)
        && request.resource.data.canonicalKey.size() > 0
        && validString(request.resource.data.title, 500)
        && request.resource.data.title.size() > 0
        && validBoundedStringList(request.resource.data.authors, 20, 160)
        && (!('year' in request.resource.data)
          || request.resource.data.year is int
            && request.resource.data.year >= 1000
            && request.resource.data.year <= 3000)
        && (!('category' in request.resource.data)
          || validString(request.resource.data.category, 120))
        // A truncated cache of the abstract, not the text (1500, not 3000).
        && (!('abstract' in request.resource.data)
          || validString(request.resource.data.abstract, 1500))
        && (!('doi' in request.resource.data)
          || validString(request.resource.data.doi, 300)
            && request.resource.data.doi.matches('^10\\.[0-9]{4,9}/.+$')
            && request.resource.data.doi == request.resource.data.doi.lower())
        // Versionless by contract: a comment belongs to the paper, not to v2.
        && (!('arxivId' in request.resource.data)
          || validString(request.resource.data.arxivId, 100)
            && request.resource.data.arxivId
              .matches('^([a-z-]+(\\.[a-z0-9-]+)?/[0-9]{7}|[0-9]{4}\\.[0-9]{4,5})$'))
        && (!('openUrl' in request.resource.data)
          || validString(request.resource.data.openUrl, 2000)
            && request.resource.data.openUrl.matches('^https://[^[:space:]]+$'))
        && stubIdentityCoherent()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;
    }

    // The author's public profile, read once per evaluation (rules memoize
    // repeated gets of the same document).
    function commentAuthorProfile() {
      return get(
        /databases/$(database)/documents/userProfiles/$(request.auth.uid)
      ).data;
    }

    function validNewComment() {
      return request.resource.data.keys().hasOnly([
          'authorUid', 'authorHandle', 'text', 'createdAt', 'status', 'replyTo'
        ])
        && request.resource.data.keys().hasAll([
          'authorUid', 'authorHandle', 'text', 'createdAt', 'status'
        ])
        && request.resource.data.authorUid == request.auth.uid
        && validString(request.resource.data.text, 4000)
        && request.resource.data.text.size() > 0
        && request.resource.data.status == 'visible'
        && request.resource.data.createdAt == request.time
        // The handle is a denormalized snapshot, and it must be the author's
        // real one at the moment of writing — anything else would let a
        // caller sign someone else's name under their own uid. This also
        // requires a profile to exist at all: no profile, no handle, no
        // public voice to speak with.
        && request.resource.data.authorHandle == commentAuthorProfile().handle
        // Commenting is a public act, so a private profile cannot do it.
        // Enforced here at the data layer, not just explained in the UI.
        && profileIsPublic(commentAuthorProfile());
    }

    // One level of threading, by construction: a reply points at a comment
    // that exists and is not itself a reply. (A crafted id equal to its own
    // replyTo dies here too — the document being created does not exist yet.)
    function validReplyTarget(paperKey) {
      return !('replyTo' in request.resource.data)
        || (request.resource.data.replyTo is string
          && exists(/databases/$(database)/documents/papers/$(paperKey)/comments/$(request.resource.data.replyTo))
          && !('replyTo' in get(
            /databases/$(database)/documents/papers/$(paperKey)/comments/$(request.resource.data.replyTo)
          ).data));
    }

    match /papers/{paperKey} {
      // Anyone may resolve a stub — the public comments view needs it signed
      // out. Nobody may page the collection: there is no paper directory
      // here, no browse, no search. The stub exists to hang threads off, and
      // access is always by id.
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null
        && !commentsFrozen()
        && validPaperStub()
        && throttleSatisfied('stubs');
      // Immutable after creation, except for the admin. The stub's metadata
      // is what every reader of the thread sees; a cache anyone could rewrite
      // would be a defacement surface. Stale metadata is repaired by the
      // admin, not by the crowd. (No client-maintained counters either:
      // comment counts are count() aggregations, the F2 pattern, so there is
      // no increment arithmetic for a cascade delete to corrupt.)
      allow update: if isAdmin();
      allow delete: if isAdmin();

      match /comments/{commentId} {
        // Reads live on the collection-group match below — one grant for the
        // thread under a paper and for "my comments" across papers.
        allow create: if request.auth != null
          && !commentsFrozen()
          && validNewComment()
          && validReplyTarget(paperKey)
          // A comment hangs off a stub that exists — already, or created in
          // this same batch (the first-comment flow).
          && existsAfter(/databases/$(database)/documents/papers/$(paperKey))
          && throttleSatisfied('comments');
        allow update: if request.auth != null
          && (
            // The author may rewrite the text, and the edit is marked with
            // the server's clock. Everything else is frozen to them —
            // including status, so editing never un-hides a hidden comment.
            (resource.data.authorUid == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['text', 'editedAt'])
              && validString(request.resource.data.text, 4000)
              && request.resource.data.text.size() > 0
              && request.resource.data.editedAt == request.time)
            // The admin moderates status and touches nothing else — hiding a
            // comment must not let anyone rewrite what it said.
            || (isAdmin()
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['status'])
              && request.resource.data.status in ['visible', 'hidden'])
          );
        // Deleting a parent takes its replies with it (the product decision:
        // no orphaned replies). The middle branch is the exception the
        // cascade needs to the "never delete someone else's comment" rule,
        // and it is scoped tight: a reply may be deleted by a stranger only
        // when its parent is going down in this same batch at the hands of
        // the parent's own author, or when the parent is already gone and
        // the reply is an orphan any signed-in caller may sweep.
        allow delete: if request.auth != null
          && (
            resource.data.authorUid == request.auth.uid
            || isAdmin()
            || ('replyTo' in resource.data
              && (
                !exists(/databases/$(database)/documents/papers/$(paperKey)/comments/$(resource.data.replyTo))
                // The author check is redundant today, and the mutation pass
                // says so: the in-batch parent delete already demands the
                // parent's author (or admin, whose branch covers replies
                // anyway), and a batch has one caller. Kept as scoping
                // defense-in-depth for any future rule that authorizes a
                // parent delete for somebody new.
                || (!existsAfter(/databases/$(database)/documents/papers/$(paperKey)/comments/$(resource.data.replyTo))
                  && get(/databases/$(database)/documents/papers/$(paperKey)/comments/$(resource.data.replyTo))
                    .data.authorUid == request.auth.uid)
              ))
          );
      }
    }

    // Read access for comments, granted on the collection-group pattern so
    // the same two lines cover a thread under one paper AND the "my
    // comments" collectionGroup query. Rules cannot see a query's `where`,
    // only its shape, so the enforceable line is the ceiling — and comments
    // are public content, like follows. Hidden comments stay readable at
    // this layer by decision (02-SECURITY.md §1): the official client
    // filters them, their author sees them marked in "my comments", and
    // definitive removal is the admin's delete. NOTE: this grant applies to
    // any subcollection named `comments`; only papers/ has one, and nothing
    // else may take that name without revisiting this block.
    match /{path=**}/comments/{commentId} {
      allow get: if true;
      allow list: if request.query.limit <= 1000;
    }

    function validReport() {
      return request.resource.data.keys().hasOnly([
          'reporterUid', 'targetPath', 'targetAuthorUid', 'reason', 'note',
          'status', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'reporterUid', 'targetPath', 'targetAuthorUid', 'reason', 'status',
          'createdAt'
        ])
        && request.resource.data.reporterUid == request.auth.uid
        && validString(request.resource.data.targetPath, 500)
        && request.resource.data.targetPath.size() > 0
        && validString(request.resource.data.targetAuthorUid, 128)
        && request.resource.data.reason in ['spam', 'abuse', 'other', 'dup-stub']
        && (!('note' in request.resource.data)
          || validString(request.resource.data.note, 500))
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time;
    }

    match /reports/{reportId} {
      // Create-only for users; the queue belongs to the admin alone. A
      // private profile CAN report — reporting is not a public act — and the
      // killswitch does not gate it: the alarm stays reachable while the
      // room is on fire.
      allow get: if isAdmin();
      allow list: if isAdmin() && request.query.limit <= 1000;
      allow create: if request.auth != null
        && validReport()
        && throttleSatisfied('reports');
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status'])
        && request.resource.data.status in ['open', 'resolved', 'dismissed'];
      allow delete: if isAdmin();
    }

    match /config/{configId} {
      // Readable so the client can say WHY a create was refused when the
      // killswitch is on, instead of a generic error. The flags reveal
      // nothing an attacker could use — refusal itself is observable.
      allow get: if configId == 'moderation';
      allow list: if false;
      allow create, update: if isAdmin()
        && configId == 'moderation'
        && request.resource.data.keys().hasOnly([
          'commentsFrozen', 'annotationsFrozen', 'relayFrozen', 'updatedAt'
        ])
        && (!('commentsFrozen' in request.resource.data)
          || request.resource.data.commentsFrozen is bool)
        && (!('annotationsFrozen' in request.resource.data)
          || request.resource.data.annotationsFrozen is bool)
        && (!('relayFrozen' in request.resource.data)
          || request.resource.data.relayFrozen is bool)
        && (!('updatedAt' in request.resource.data)
          || request.resource.data.updatedAt == request.time);
      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
