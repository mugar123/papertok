{
  "name": "papertok",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:emulators": "firebase emulators:exec \"vite --mode emulators\" --only auth,firestore --import .firebase-emulators --export-on-exit",
    "build": "vite build",
    "lint": "npm run worker:types && eslint --flag unstable_native_nodejs_ts_config .",
    "typecheck": "npm run worker:types && tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p worker/tsconfig.json && tsc --noEmit -p worker/tsconfig.test.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p proxy/tsconfig.json && tsc --noEmit -p proxy/tsconfig.test.json",
    "security:secrets": "node scripts/check-secrets.ts",
    "test": "node --test \"src/**/*.test.ts\" \"worker/**/*.test.ts\" \"proxy/**/*.test.ts\" \"scripts/**/*.test.ts\" \"eslint-rules/**/*.test.ts\"",
    "generate:openalex-topics": "node scripts/generate-openalex-leaf-topics.ts",
    "check": "npm run security:secrets && npm run lint && npm run knip && npm run typecheck && npm test && npm run build && npm run worker:deploy:dry-run",
    "preview": "vite preview",
    "worker:deploy": "node --env-file-if-exists=.env.posthog-cli scripts/deploy-worker.ts",
    "worker:deploy:dry-run": "wrangler deploy --dry-run",
    "worker:types": "wrangler types",
    "test:rules": "firebase emulators:exec --only firestore --project papertok-rules-test \"node --test tests/firestore.rules.test.ts\"",
    "knip": "knip"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@opentelemetry/api": "^1.10.0",
    "@phosphor-icons/react": "^2.1.10",
    "@resvg/resvg-wasm": "2.6.2",
    "@vercel/analytics": "^2.0.1",
    "bloomfilter": "^1.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "fast-xml-parser": "^5.10.1",
    "firebase": "^12.14.0",
    "framer-motion": "^12.40.0",
    "katex": "^0.17.0",
    "pdfjs-dist": "6.3.289",
    "posthog-js": "^1.435.5",
    "posthog-node": "^5.57.1",
    "protobufjs": "7.6.5",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "7.18.2",
    "satori": "0.32.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/css": "^2.0.1",
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@posthog/cli": "^0.18.12",
    "@posthog/rollup-plugin": "^1.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/deno": "^2.7.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "knip": "^6.43.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.0.12",
    "vite-plugin-pwa": "^1.3.0",
    "wrangler": "4.122.0"
  },
  "overrides": {
    "sharp": "0.35.4"
  }
}
