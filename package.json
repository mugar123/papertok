{
  "name": "papertok",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "security:secrets": "node scripts/check-secrets.mjs",
    "test": "node --test $(find src worker proxy -name '*.test.js')",
    "check": "npm run security:secrets && npm run lint && npm test && npm run build && npm run worker:deploy:dry-run",
    "preview": "vite preview",
    "worker:deploy": "wrangler deploy",
    "worker:deploy:dry-run": "wrangler deploy --dry-run",
    "test:rules": "firebase emulators:exec --only firestore --project papertok-rules-test \"node --test tests/firestore.rules.test.js\""
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@vercel/analytics": "^2.0.1",
    "@vnedyalk0v/react19-simple-maps": "^2.0.9",
    "bloomfilter": "^1.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "fast-xml-parser": "^5.10.1",
    "firebase": "^12.14.0",
    "framer-motion": "^13.1.1",
    "html2canvas-pro": "^2.4.0",
    "jspdf": "^4.2.1",
    "katex": "^0.17.0",
    "lucide-react": "^1.18.0",
    "protobufjs": "7.6.5",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "7.18.2",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.0.12",
    "vite-plugin-pwa": "^1.3.0",
    "wrangler": "4.122.0"
  }
