# Copy to .env.local (`cp .env.example .env.local`). Every VITE_* value ends up
# in the built JavaScript, so none of them is a secret — Worker tokens live in
# `wrangler secret put`, never here. See docs/DEVELOPMENT.md.

VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# No analytics variable. Vercel Web Analytics needs no id in the bundle: the
# script is served from the deployment's own origin (/_vercel/insights) and the
# project it reports to is the project that served it.

# Required. `vite build` aborts without it: fifteen services read it, and a
# bundle built without it reaches no backend at all — a failure that only shows
# up in the browser, which is why the build refuses to produce it.
VITE_PAPER_API_BASE_URL=http://localhost:8787

VITE_REPORT_API_URL=http://localhost:8787

# Must match the value declared in `src/utils/deployFlags.js` (today: false).
# `vite build` fails when the two disagree, because the decision belongs in that
# file, in the commit that records why, not in an environment variable.
VITE_SCOPUS_ENABLED=false

VITE_UNPAYWALL_EMAIL=you@example.com
